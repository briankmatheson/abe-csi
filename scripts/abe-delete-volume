#!/usr/bin/env bash
# abe-delete-volume <volume_id>
#
# DELETE /v1/volumes/<id>: xdebbied unexports and removes it on ABE. Gone
# already is fine; still attached (409) is an error so the provisioner
# retries after the node has let go.
set -euo pipefail
source "$(dirname "$0")/common.sh"
need_root
require_cmds curl jq

[[ $# -ge 1 ]] || { echo "usage: $0 <volume_id>" >&2; exit 2; }
VOL_ID="$1"

RESP=$(xd DELETE "/volumes/$VOL_ID") || die "xdebbied unreachable at $XDEBBIE_URL"
case "$XD_CODE" in
  2*|404) log "deleted $VOL_ID" ;;
  *)      die "xdebbied DELETE /volumes/$VOL_ID: $(xd_err "$RESP")" ;;
esac
