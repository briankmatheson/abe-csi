#!/usr/bin/env bash
# abe-unmount-and-disconnect <volume_id> <target_path>
#
# Unmount one publish target. Only when no other mounts of the volume
# remain on this node do we close the LUKS mapping and drop the NVMe/TCP
# connection (RWO still allows several pods on the same node).
set -euo pipefail
source "$(dirname "$0")/common.sh"
need_root
require_cmds nvme cryptsetup findmnt umount

[[ $# -ge 2 ]] || { echo "usage: $0 <volume_id> <target_path>" >&2; exit 2; }
VOL_ID="$1"; TARGET="$2"
MAP=$(mapper_name "$VOL_ID")

if findmnt -M "$TARGET" >/dev/null 2>&1; then
  umount "$TARGET"
  log "unmounted $TARGET"
fi
rmdir "$TARGET" 2>/dev/null || true

# Anything else still using this volume?
SRC=""
if [[ -e "/dev/mapper/$MAP" ]]; then
  SRC="/dev/mapper/$MAP"
elif DEV=$(find_device "$VOL_ID" 2>/dev/null); then
  SRC="$DEV"
fi
if [[ -n "$SRC" ]] && findmnt -S "$SRC" >/dev/null 2>&1; then
  log "$SRC still mounted elsewhere; leaving attached"; exit 0
fi

if [[ -e "/dev/mapper/$MAP" ]]; then
  cryptsetup close "$MAP" && log "closed $MAP"
fi
if is_connected "$VOL_ID"; then
  nvme disconnect -n "$VOL_ID" >/dev/null && log "disconnected $VOL_ID"
fi
