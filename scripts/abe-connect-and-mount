#!/usr/bin/env bash
# abe-connect-and-mount <volume_id> <target_path> [KEY=VALUE...]
#
# Attach an ABE volume over NVMe/TCP, optionally unlock it with LUKS, make a
# filesystem on first use, and mount it at <target_path>.
#
#   PLAN=host:port:id   from volume_context (set by CreateVolume)
#   HOSTS=ip            fallback if no plan is known yet
#   FS_TYPE=ext4        filesystem to create on first use (default ext4)
#   MOUNT_OPTS=a,b      mount -o options
#
# LUKS passphrase: when ABE_LUKS_KEY_STDIN=1 the passphrase is read from
# stdin (the CSI driver pipes the node-publish secret in). It is never
# placed in argv or the environment. Without a passphrase the volume is
# used unencrypted.
set -euo pipefail
source "$(dirname "$0")/common.sh"
need_root
require_cmds curl jq nvme cryptsetup blkid mount findmnt mkfs.ext4
ensure_dirs

[[ $# -ge 2 ]] || { echo "usage: $0 <volume_id> <target_path> [KEY=VALUE...]" >&2; exit 2; }
VOL_ID="$1"; TARGET="$2"; shift 2
parse_kv "$@"
FS_TYPE=${ABE_PARAM_FS_TYPE:-ext4}
MOUNT_OPTS=${ABE_PARAM_MOUNT_OPTS:-defaults}

LUKS_KEY=""
if [[ "${ABE_LUKS_KEY_STDIN:-0}" == "1" ]]; then
  LUKS_KEY=$(cat)
fi

mkdir -p "$TARGET"
if findmnt -M "$TARGET" >/dev/null 2>&1; then
  log "$TARGET already mounted"; exit 0
fi

# --- plan -----------------------------------------------------------------
PLAN_FILE="$ABE_VOL_DIR/$VOL_ID/plan"
if [[ ! -f "$PLAN_FILE" && -n "${ABE_PARAM_PLAN:-}" ]]; then
  persist_plan "$VOL_ID" "$ABE_PARAM_PLAN"
fi
if [[ ! -f "$PLAN_FILE" ]]; then
  HOST=$(resolve_host) || die "no plan for $VOL_ID and no ABE host to ask"
  persist_plan "$VOL_ID" "$HOST::$VOL_ID"
fi
PLAN=$(read_plan "$VOL_ID")
HOST=$(echo "$PLAN" | cut -d: -f1)

# --- attach ---------------------------------------------------------------
if ! is_connected "$VOL_ID"; then
  ensure_nvme_tcp
  # Ask ABE to (re)export; the port may have changed since provisioning.
  PLAN=$(refresh_host "$HOST" "$VOL_ID") || die "ABE /id/$VOL_ID failed on $HOST"
  persist_plan "$VOL_ID" "$PLAN"
  PORT=$(echo "$PLAN" | cut -d: -f2)
  log "nvme connect -a $HOST -t tcp -s $PORT -n $VOL_ID"
  nvme connect -a "$HOST" -t tcp -s "$PORT" -n "$VOL_ID"
fi
DEV=$(wait_device "$VOL_ID") || die "device for $VOL_ID did not appear"
log "attached $VOL_ID as $DEV"

# --- encryption -----------------------------------------------------------
SRC="$DEV"
if [[ -n "$LUKS_KEY" ]]; then
  MAP=$(mapper_name "$VOL_ID")
  if [[ ! -e "/dev/mapper/$MAP" ]]; then
    if ! cryptsetup isLuks "$DEV" >/dev/null 2>&1; then
      existing_type=$(blkid -p -o value -s TYPE "$DEV" 2>/dev/null || true)
      if [[ -n "$existing_type" ]]; then
        die "$DEV already has a $existing_type signature but is not LUKS; refusing to format"
      fi
      log "luksFormat $DEV"
      printf '%s' "$LUKS_KEY" | cryptsetup -q luksFormat --type luks2 --key-file=- "$DEV"
    fi
    log "luksOpen $DEV -> $MAP"
    printf '%s' "$LUKS_KEY" | cryptsetup open --key-file=- "$DEV" "$MAP"
  fi
  SRC="/dev/mapper/$MAP"
elif cryptsetup isLuks "$DEV" >/dev/null 2>&1; then
  die "$DEV is LUKS but no passphrase was supplied (set node-publish secret on the StorageClass)"
fi

# --- filesystem -----------------------------------------------------------
if ! blkid -p -o value -s TYPE "$SRC" >/dev/null 2>&1 || [[ -z "$(blkid -p -o value -s TYPE "$SRC" 2>/dev/null)" ]]; then
  log "mkfs.$FS_TYPE $SRC"
  "mkfs.$FS_TYPE" -q "$SRC"
fi

mount -o "$MOUNT_OPTS" "$SRC" "$TARGET"
log "mounted $VOL_ID ($SRC) at $TARGET"
