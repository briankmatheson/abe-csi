#!/usr/bin/env bash
# abe-create-volume <name> [KEY=VALUE...]
#
# Provision a volume on a single ABE host and print its volume id.
# Parameters: HOSTS=<ip> (StorageClass; first host is used),
#             CAPACITY_BYTES=<n> (from the CSI request; 0/absent = ABE default)
# The host:port:id plan is persisted locally and read back by the CSI
# controller, which forwards it to nodes via volume_context. ABE's fio
# numbers (if any) land in volumes/<id>/perf for the controller to annotate
# the PV with.
set -euo pipefail
source "$(dirname "$0")/common.sh"
need_root
require_cmds curl jq
ensure_dirs

[[ $# -ge 1 ]] || { echo "usage: $0 <name> [HOSTS=ip]" >&2; exit 2; }
VOL_NAME="$1"; shift || true
parse_kv "$@"

HOST=$(resolve_host) || die "no ABE host: set StorageClass parameter 'hosts' or $ABE_HOSTS_FILE"

log "provisioning '$VOL_NAME' on $HOST (${ABE_PARAM_CAPACITY_BYTES:-default} bytes)"
PLAN=$(configure_host "$HOST" "${ABE_PARAM_CAPACITY_BYTES:-}") || die "ABE /configure failed on $HOST"
VOL_ID=${PLAN##*:}
persist_plan "$VOL_ID" "$PLAN"
log "provisioned $VOL_ID ($PLAN)"
echo "$VOL_ID"
