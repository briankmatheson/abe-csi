#!/usr/bin/env bash
# abe-create-volume <name> [KEY=VALUE...]
#
# Ask xdebbied for a volume (POST /v1/volumes); it does ABE /configure on a
# healthy host's ABE. Prints the Volume record as JSON: the controller reads
# id, bytes and perf from it. Idempotent on name (a replay gets the same
# volume back), so no local state is kept.
#
# Parameters: CAPACITY_BYTES=<n> (from the CSI request; 0/absent = 1 GiB),
#             HOST=<name> (StorageClass; which host's ABE, default any).
set -euo pipefail
source "$(dirname "$0")/common.sh"
need_root
require_cmds curl jq

[[ $# -ge 1 ]] || { echo "usage: $0 <name> [KEY=VALUE...]" >&2; exit 2; }
VOL_NAME="$1"; shift || true
parse_kv "$@"

BYTES=${ABE_PARAM_CAPACITY_BYTES:-0}
[[ "$BYTES" -gt 0 ]] || BYTES=$((1 << 30))
BODY=$(jq -nc --arg n "$VOL_NAME" --argjson b "$BYTES" --arg h "${ABE_PARAM_HOST:-}" \
  '{name: $n, bytes: $b} + (if $h != "" then {host: $h} else {} end)')

log "creating '$VOL_NAME' ($BYTES bytes) via $XDEBBIE_URL"
xd POST /volumes "$BODY" || die "xdebbied unreachable at $XDEBBIE_URL"
RESP=$XD_BODY
xd_ok || die "xdebbied POST /volumes: $(xd_err "$RESP")"
ID=$(echo "$RESP" | jq -r '.id // empty')
[[ -n "$ID" ]] || die "no id in reply: $RESP"
case "$XD_CODE" in
  201) log "created $ID ($(echo "$RESP" | jq -r .bytes) bytes)" ;;
  *)   log "'$VOL_NAME' already exists as $ID" ;;
esac
if PERF=$(echo "$RESP" | jq -er '.perf | "\(.write_lat_us) us, \(.write_iops) IOPS, \(.write_mib_s) MiB/s at bs=\(.bs) iodepth=\(.iodepth)"' 2>/dev/null); then
  log "perf for $ID: $PERF"
fi
echo "$RESP"
