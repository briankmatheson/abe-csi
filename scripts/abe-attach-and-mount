#!/usr/bin/env bash
# abe-attach-and-mount <volume_id> <target_path> [KEY=VALUE...]
#
# Have xdebbied hot-plug the volume into this VM (host-side NVMe/TCP, guest
# sees a virtio disk), optionally unlock it with LUKS, make a filesystem on
# first use, and mount it at <target_path>.
#
#   FS_TYPE=ext4        filesystem to create on first use (default ext4)
#   MOUNT_OPTS=a,b      mount -o options
#
# LUKS passphrase: when ABE_LUKS_KEY_STDIN=1 the passphrase is read from
# stdin (the CSI driver pipes the node-publish secret in). It is never
# placed in argv or the environment. Without a passphrase the volume is
# used unencrypted.
set -euo pipefail
source "$(dirname "$0")/common.sh"
need_root
require_cmds curl jq cryptsetup blkid mount findmnt mkfs.ext4

[[ $# -ge 2 ]] || { echo "usage: $0 <volume_id> <target_path> [KEY=VALUE...]" >&2; exit 2; }
VOL_ID="$1"; TARGET="$2"; shift 2
parse_kv "$@"
FS_TYPE=${ABE_PARAM_FS_TYPE:-ext4}
MOUNT_OPTS=${ABE_PARAM_MOUNT_OPTS:-defaults}
# Two reconcile ticks plus a host-side nvme connect is normal; a VM that is
# still provisioning can take longer and kubelet retries anyway.
ATTACH_TIMEOUT=${ABE_ATTACH_TIMEOUT:-90}

LUKS_KEY=""
if [[ "${ABE_LUKS_KEY_STDIN:-0}" == "1" ]]; then
  LUKS_KEY=$(cat)
  log "LUKS passphrase provided via stdin"
fi

mkdir -p "$TARGET"
if findmnt -M "$TARGET" >/dev/null 2>&1; then
  log "$TARGET already mounted"; exit 0
fi

# --- attach ---------------------------------------------------------------
ME=$(vm_uuid)
DEV=$(guest_dev "$VOL_ID")
if [[ ! -b "$DEV" ]]; then
  RESP=$(xd POST "/volumes/$VOL_ID/attach" "{\"vm\":\"$ME\"}") || die "xdebbied unreachable at $XDEBBIE_URL"
  xd_ok || die "xdebbied attach $VOL_ID -> $ME: $(xd_err "$RESP")"
  log "asked xdebbied to attach $VOL_ID to this vm ($ME)"
  deadline=$((SECONDS + ATTACH_TIMEOUT)); msg=""
  while [[ ! -b "$DEV" ]]; do
    (( SECONDS < deadline )) || die "$DEV did not appear within ${ATTACH_TIMEOUT}s${msg:+ (xdebbied: $msg)}"
    sleep 2
    if RESP=$(XD_TIMEOUT=10 xd GET "/volumes/$VOL_ID") && xd_ok; then
      msg=$(echo "$RESP" | jq -r '.message // empty')
      [[ -n "$msg" ]] && log "waiting: $msg"
    fi
  done
fi
log "attached $VOL_ID as $DEV"

# --- encryption -----------------------------------------------------------
SRC="$DEV"
if [[ -n "$LUKS_KEY" ]]; then
  MAP=$(mapper_name "$VOL_ID")
  if [[ ! -e "/dev/mapper/$MAP" ]]; then
    if ! cryptsetup isLuks "$DEV" >/dev/null 2>&1; then
      existing_type=$(blkid -p -o value -s TYPE "$DEV" 2>/dev/null || true)
      if [[ -n "$existing_type" ]]; then
        die "$DEV already has a $existing_type signature but is not LUKS; refusing to format"
      fi
      log "luksFormat $DEV"
      printf '%s' "$LUKS_KEY" | cryptsetup -q luksFormat --type luks2 --key-file=- "$DEV"
    fi
    log "luksOpen $DEV -> $MAP"
    printf '%s' "$LUKS_KEY" | cryptsetup open --key-file=- "$DEV" "$MAP"
  fi
  SRC="/dev/mapper/$MAP"
elif cryptsetup isLuks "$DEV" >/dev/null 2>&1; then
  die "$DEV is LUKS but no passphrase was supplied (set node-publish secret on the StorageClass)"
fi

# --- filesystem -----------------------------------------------------------
if [[ -z "$(blkid -p -o value -s TYPE "$SRC" 2>/dev/null)" ]]; then
  log "mkfs.$FS_TYPE $SRC"
  "mkfs.$FS_TYPE" -q "$SRC"
fi

mount -o "$MOUNT_OPTS" "$SRC" "$TARGET"
log "mounted $VOL_ID ($SRC) at $TARGET"
